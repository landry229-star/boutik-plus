APP_NAME="Boutik Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Porto-Novo

# Pour changer le nom ou l'e-mail du patron, modifiez ces valeurs dans le fichier .env local.
BOUTIK_PATRON_NAME="Patron Boutik"
BOUTIK_PATRON_EMAIL=patron@boutik.local
# Mot de passe du patron : gardez le vrai mot de passe uniquement dans .env, jamais dans ce fichier exemple.
# S'il est vide lors de la création initiale, le seeder générera un mot de passe aléatoire et l'affichera une fois.
BOUTIK_PATRON_PASSWORD=
# Pour remplacer un compte patron existant après modification des identifiants, mettez temporairement
# RECREER_PATRON ici dans .env local, lancez le seeder, puis effacez cette confirmation.
BOUTIK_PATRON_RECREATE_CONFIRM=

# Valeurs initiales de l'identite commerciale ; vous pourrez ensuite les modifier dans l'espace patron, menu Boutique.
BOUTIK_COMPANY_NAME="Boutik Plus"
BOUTIK_COMPANY_ADDRESS=
BOUTIK_COMPANY_PHONE=
BOUTIK_COMPANY_EMAIL=
BOUTIK_COMPANY_IFU=
BOUTIK_COMPANY_RCCM=
# Ancienne configuration d'identifiant encore lue pour la migration des installations existantes.
BOUTIK_COMPANY_IDENTIFIER_LABEL="Identifiant fiscal"
BOUTIK_COMPANY_IDENTIFIER=
# Relative to storage/app/public, for example branding/logo.png (PNG or JPEG, max 2 MB).
BOUTIK_COMPANY_LOGO_PATH=
BOUTIK_COMPANY_LEGAL_NOTICE=
BOUTIK_CURRENCY=FCFA

# Tax is intentionally disabled until your accountant confirms the applicable regime and rate.
BOUTIK_TAX_ENABLED=false
BOUTIK_TAX_RATE=0
BOUTIK_TAX_LABEL=

# Mobile Money stays disabled until provider credentials and callback handling are configured.
BOUTIK_MOBILE_MONEY_ENABLED=false
BOUTIK_MOBILE_MONEY_PROVIDER=fedapay
BOUTIK_MOBILE_MONEY_CURRENCY=XOF
BOUTIK_MOBILE_MONEY_TIMEOUT=15

# FedaPay: configurez aussi https://votre-domaine/webhooks/fedapay dans le tableau de bord marchand.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# MTN MoMo: use credentials and URLs from the selected MTN developer environment.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_WEBHOOK_SECRET=

# Moov Money API details depend on the country and the operator's/aggregator's contract.
MOOV_MONEY_BASE_URL=
MOOV_MONEY_CLIENT_ID=
MOOV_MONEY_CLIENT_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_CALLBACK_URL=
MOOV_MONEY_WEBHOOK_SECRET=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Remplacez ces valeurs par celles fournies par votre service de messagerie.
# Utilisez smtp avec le port 587 ; pour une connexion SSL implicite sur le port 465, utilisez smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
